# Facebook App Configuration
FB_APP_ID=your_app_id
FB_APP_SECRET=your_app_secret
FB_VERIFY_TOKEN=your_custom_verify_token
FB_PAGE_ACCESS_TOKEN=your_page_access_token

# Database
DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=your_db;charset=utf8mb4
DB_USER=your_user
DB_PASS=your_password

# Graph API
FB_GRAPH_API_VERSION=v21.0
FB_GRAPH_API_URL=https://graph.facebook.com

# Application
APP_URL=https://yourdomain.com
ADMIN_TOKEN=change_me_to_a_strong_random_string
ADMIN_ALLOWED_IPS=          # để trống = cho phép mọi IP; VD: 1.2.3.4,5.6.7.8
TRUST_PROXY=0               # đặt 1 nếu chạy sau nginx/load balancer
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=debug
LOG_PATH=logs/app.log
